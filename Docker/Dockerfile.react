# Stage 1: Build the React application
FROM node:20-alpine AS build

WORKDIR /app

# Enable pnpm via corepack and install dependencies
ENV PNPM_HOME="/root/.local/share/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable

COPY React/package.json React/pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

COPY React ./React

WORKDIR /app/React
RUN pnpm run build

# Stage 2: Serve the compiled assets with Nginx and proxy API calls
FROM nginx:1.27-alpine AS runner

WORKDIR /usr/share/nginx/html

COPY --from=build /app/React/dist ./
COPY Docker/config/react.nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
